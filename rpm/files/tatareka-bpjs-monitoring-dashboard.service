[Unit]
Description=tatareka-bpjs-monitoring: rebuild the Dashboard Klaim BPJS dashboard data from SIMGOS
After=mysqld.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /opt/tatareka-bpjs-monitoring/bpjs_monitoring.py dashboard
TimeoutStartSec=5min
Nice=10
