[Unit]
Description=tatareka-bpjs-monitoring: refresh SIMGOS's BPJS claim status through its own Status Klaim
After=network-online.target mysqld.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /opt/tatareka-bpjs-monitoring/bpjs_monitoring.py run
TimeoutStartSec=70min
Nice=10
